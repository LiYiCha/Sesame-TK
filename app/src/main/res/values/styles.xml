<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!--  AppBar 背景色  -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!--  Toolbar 文字颜色  -->
        <item name="titleTextColor">@color/active_text</item>
        <item name="subtitleTextColor">@color/active_text</item>
        <!--  状态栏透明  -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!--  导航栏颜色  -->
        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="windowNoTitle">true</item>
        <!--  菜单样式  -->
        <item name="actionOverflowMenuStyle">@style/MenuTheme</item>
        <!--  确保 PopupMenu 样式正确  -->
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_background</item>
    </style>

    <style name="MenuTheme" parent="Widget.Material3.PopupMenu">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorPrimary</item>
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:itemBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
    </style>

    <style name="Widget.App.Button.Main" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="iconTint">@null</item>
        <item name="iconSize">32dp</item>
        <item name="iconGravity">top</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_lg</item>
        <item name="android:textSize">@dimen/text_label_large</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">1dp</item>
    </style>

    <!--请求-->
    <style name="GlassInputStyle">
        <item name="android:background">@drawable/bg_glass_input</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOutline</item>
        <item name="counterTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="GlassButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="cornerRadius">24dp</item>
    </style>

</resources>
