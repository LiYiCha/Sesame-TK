<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="fansirsqi.xposed.sesame">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--唤醒权限-->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      NPatch 本地模式：管理器通过 RemoteApiProvider 向模块 App 暴露 Remote Preferences / Remote Files。
      Android 11+ 不声明 <queries> 时 PackageManager 与 Provider 解析都会失败，
      因此显式声明 NPatch 的 remote authority 与管理器包名（仅用于探测与后续接入 Remote SDK）。
    -->
    <queries>
        <provider android:authorities="top.nkbe.npatch.remote" />
        <package android:name="top.nkbe.npatch" />
    </queries>

    <application
        android:name="fansirsqi.xposed.sesame.MyApplication"
        android:allowBackup="true"
        tools:replace="android:allowBackup"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <!-- 允许注入进程通过 XSharedPreferences 读取模块配置（LSPosed 需要；NPatch 由 Vector 文件服务解析） -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="竹外一枝斜，想佳人，天寒日暮" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scopes" />

        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.MainActivity"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ui.MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="fansirsqi.xposed.sesame.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.ExtendActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.WebSettingsActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.SettingActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.logviewer.HtmlViewerActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.logviewer.LogViewerComposeActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.extra.activity.RpcDebugActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.extra.activity.HelpActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.extension.ExtensionListActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.skin.SkinActivity"
            android:exported="true"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.skin.SkinDetailActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.theme.alipay.AlipayThemeActivity"
            android:exported="true"
            android:resizeableActivity="true" />

        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.network.CaptureSettingsActivity"
            android:exported="true"
            android:resizeableActivity="true" />

        <activity
            android:configChanges="uiMode|screenSize"
            android:name="fansirsqi.xposed.sesame.ui.extension.SeckillActivity"
            android:exported="true"
            android:resizeableActivity="true" />

        <!-- 下载管理与更新列表页面，统一使用主模块的主题样式 AppTheme -->
        <activity
            android:name="com.updater.ui.DownloadManagerActivity"
            android:theme="@style/AppTheme"
            android:configChanges="uiMode|screenSize"
            android:exported="false"
            tools:replace="android:theme" />

        <!-- FileProvider 用于安装 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
